# Database
DATABASE_URL="mysql://username:password@localhost:3306/stock_management?schema=public"

# Auth
# WAJIB secret acak min 32 karakter — placeholder TIDAK akan diterima.
# Generate: openssl rand -base64 48
JWT_SECRET=""
CSRF_SECRET=""

# Seed passwords (hanya dipakai prisma db seed; wajib di production)
SEED_ADMIN_PASSWORD=""
SEED_STAFF_PASSWORD=""
SEED_VIEWER_PASSWORD=""

# Redis (rate limiting login — opsional; jika tidak tersedia, rate limit fail-open)
REDIS_URL="redis://localhost:6379"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"